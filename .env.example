# ============================================================
# Exemplo de variáveis de ambiente do projeto
# ============================================================
# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo ".env" NÃO é versionado (está no .gitignore).
#
# No Vite, as variáveis precisam começar com VITE_ para ficarem
# disponíveis no front-end.

# EmailJS — crie sua conta em https://www.emailjs.com/
# e obtenha estes valores no painel (dashboard.emailjs.com/admin).
VITE_EMAILJS_SERVICE_ID=seu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=seu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=sua_public_key_aqui